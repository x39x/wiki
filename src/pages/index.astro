---
import Layout from "../Layout.astro";
import { getNav, getTags } from "../lib/data.js";

const nav = getNav();
const tags = getTags();
---

<Layout title="Home">
    <main class="page">
        <section class="section">
            <h1>分类</h1>
            <div class="grid">
                {nav.map((category) => (
                    <div class="card">
                        <h3>{category.name}</h3>
                        <ul>
                            {category.pages.map((p) => (
                                <li>
                                    <a href={`/wiki/${p.slug}`} title={p.title}>
                                        {p.label}
                                    </a>
                                </li>
                            ))}
                            {category.groups.map((group) => (
                                <li class="sub-card">
                                    <div class="group">{group.name}</div>
                                    <ul>
                                        {group.pages.map((p) => (
                                            <li>
                                                <a href={`/wiki/${p.slug}`} title={p.title}>
                                                    {p.label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>

        <section class="section">
            <h1>标签</h1>
            <div class="grid">
                {tags.map(({ tag, pages }) => (
                    <div class="card">
                        <h3>{tag}</h3>
                        <ul>
                            {pages.map((p) => (
                                <li>
                                    <a href={`/wiki/${p.slug}`} title={p.path}>
                                        {p.path}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>
    </main>
</Layout>

<style>
    .page {
        max-width: 1139px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    h1 {
        margin-top: 4rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(239px, 1fr));
        gap: 1rem;
    }

    .card {
        border-left: 1px solid var(--border);
        padding-left: 1rem;
        margin-top: 2rem;
    }

    .card ul {
        margin: 0;
        padding-left: 0.39rem;
        list-style: none;
    }

    .group {
        margin-top: 0.5rem;
        font-weight: bold;
    }

    .sub-card ul {
        margin-left: 1.25rem;
    }

    @media (max-width: 500px) {
        .card {
            border-left: none;
            padding-left: 1.05rem;
        }

        .grid {
            grid-template-columns: repeat(auto-fill, minmax(339px, 1fr));
        }
    }
</style>
